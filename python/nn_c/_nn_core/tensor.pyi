class Tensor:
    """N-dimensional tensor backed by C memory."""

    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    def __init__(self, shape: list[int]) -> None: ...
    @staticmethod
    def from_bytes(data: bytes, shape: list[int]) -> Tensor: ...
    @staticmethod
    def from_list(data: list[float], shape: list[int]) -> Tensor: ...
    @staticmethod
    def ones_like(other: Tensor) -> Tensor: ...
    def to_bytes(self) -> bytes: ...
    def to_list(self) -> list[float]: ...
    def __getitem__(self, idx: int | tuple[int, ...]) -> float: ...
    def __setitem__(self, idx: int | tuple[int, ...], value: float) -> None: ...
    def add(self, other: Tensor) -> Tensor: ...
    def subtract(self, other: Tensor) -> Tensor: ...
    def elementwise_mul(self, other: Tensor) -> Tensor: ...
    def matmul(self, other: Tensor) -> Tensor: ...
    def relu(self) -> Tensor: ...
    def transpose2d(self) -> Tensor: ...
    def scale(self, scalar: float) -> Tensor: ...
    def clone(self) -> Tensor: ...
    def fill(self, value: float) -> None: ...
    def sum(self) -> float: ...
    def argmax(self) -> int: ...
    @staticmethod
    def relu_backward(grad_output: Tensor, input: Tensor) -> Tensor: ...
    @staticmethod
    def sigmoid_backward(grad_output: Tensor, sigmoid_out: Tensor) -> Tensor: ...
